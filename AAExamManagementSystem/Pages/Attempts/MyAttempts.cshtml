@page
@model AAExamManagementSystem.Pages.Attempts.MyAttemptsModel
@{
    ViewData["Title"] = "My Attempts";
    Layout = "_ApplicantLayout";
}

<h1 class="h4 fw-bold mb-4"><i class="bi bi-clipboard-check" aria-hidden="true"></i> My Attempts</h1>

<div class="card border rounded-2 p-4">
    <div class="card-body">
        @if (Model.Attempts.Count == 0)
        {
            <div class="alert alert-info mb-0" role="alert">
                You haven't submitted an exam attempt yet.
                <a asp-page="/Attempts/Take" class="alert-link">Take your assessment</a>.
            </div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="text-start">Section</th>
                        <th class="text-start">Date Taken</th>
                        <th class="text-start">Score</th>
                        <th class="text-start">Status</th>
                        <th class="text-start">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td class="text-start">@(attempt.Section ?? "-")</td>
                            <td class="text-start">@(attempt.DateTaken ?? "-")</td>
                            <td class="text-start">
                                @if (attempt.IsApproved)
                                {
                                    @:@attempt.TotalScore / @attempt.MaxScore
                                }
                                else
                                {
                                    @:—
                                }
                            </td>
                            <td class="text-start">
                                @if (attempt.IsApproved)
                                {
                                    <span class="badge rounded-pill text-bg-success">Approved</span>
                                }
                                else if (attempt.PendingEvaluationCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-warning">Needs Evaluation</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Pending Approval</span>
                                }
                            </td>
                            <td class="text-start">
                                <a asp-page="/Attempts/MyAttemptDetails" asp-route-id="@attempt.Id" class="btn btn-primary btn-sm">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
