@page
@model AAExamManagementSystem.Pages.Attempts.IndexModel
@{
    ViewData["Title"] = "Exam Attempts";
}

<div class="card border rounded-2 p-4">
    <div class="card-header bg-white border-bottom-0">
        <h5 class="mb-0 fw-semibold entity-table-title"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Exam Attempts</h5>
    </div>
    <div class="card-body">
        @if (Model.Attempts.Count == 0)
        {
            <div class="alert alert-info mb-0" role="alert">No exam attempts have been submitted yet.</div>
        }
        else
        {
            <table id="attemptsTable" class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="text-start">Applicant</th>
                        <th class="text-start">Student No.</th>
                        <th class="text-start">Section</th>
                        <th class="text-start">Date Taken</th>
                        <th class="text-start">Score</th>
                        <th class="text-start">Status</th>
                        <th class="text-start">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td class="text-start">@attempt.ApplicantName</td>
                            <td class="text-start">@attempt.StudentNo</td>
                            <td class="text-start">@(attempt.Section ?? "-")</td>
                            <td class="text-start">@(attempt.DateTaken ?? "-")</td>
                            <td class="text-start">@attempt.TotalScore / @attempt.MaxScore</td>
                            <td class="text-start">
                                @if (attempt.IsApproved)
                                {
                                    <span class="badge rounded-pill text-bg-success">Approved</span>
                                }
                                else if (attempt.PendingEvaluationCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-warning">Needs Evaluation</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Pending Approval</span>
                                }
                            </td>
                            <td class="text-start">
                                <a asp-page="/Attempts/Review" asp-route-id="@attempt.Id" class="btn btn-primary">Review</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            if ($('#attemptsTable').length) {
                initEntityTable('attemptsTable', { order: [] });
            }
        });
    </script>
}
