@page "{id:int}"
@model AAExamManagementSystem.Pages.Attempts.ReviewModel
@{
    ViewData["Title"] = "Review Attempt";
}

@if (Model.Attempt is null)
{
    <p>Attempt not found.</p>
}
else
{
    var attempt = Model.Attempt;
    <h1 class="h4 fw-bold mb-4"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Review Attempt</h1>

    <div class="card border rounded-2 p-3 mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Applicant</dt>
                <dd class="col-sm-9">@attempt.ApplicantName (@attempt.StudentNo)</dd>

                <dt class="col-sm-3">Section</dt>
                <dd class="col-sm-9">@(attempt.Section ?? "-")</dd>

                <dt class="col-sm-3">Date Taken</dt>
                <dd class="col-sm-9">@(attempt.DateTaken ?? "-")</dd>

                <dt class="col-sm-3">Score</dt>
                <dd class="col-sm-9">@attempt.TotalScore / @attempt.MaxScore</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (attempt.IsApproved)
                    {
                        <span class="badge bg-success">Approved by @attempt.ApprovedBy</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending Approval</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <form method="post" asp-page-handler="Approve" asp-route-id="@attempt.Id">
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Question</th>
                        <th>Answer</th>
                        <th>Correct?</th>
                        <th style="width:120px">Points</th>
                        <th>Checked By</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < attempt.Answers.Count; i++)
                    {
                        var answer = attempt.Answers[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@answer.QuestionTitle</td>
                            <td>@(string.IsNullOrEmpty(answer.AnswerText) ? "(no answer)" : answer.AnswerText)</td>
                            <td>
                                @if (answer.IsUpToEvaluation)
                                {
                                    <select name="Corrections[@answer.Id]" class="form-select form-select-sm">
                                        <option value="Yes" selected="@(answer.IsCorrect == "Yes")">Yes</option>
                                        <option value="No" selected="@(answer.IsCorrect != "Yes")">No</option>
                                    </select>
                                }
                                else if (answer.IsCorrect == "Yes")
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>
                            <td>
                                @if (answer.IsUpToEvaluation)
                                {
                                    <input type="number" name="Points[@answer.Id]" value="@answer.Point" min="0" max="@answer.MaxScore" class="form-control form-control-sm" />
                                }
                                else
                                {
                                    @answer.Point <text> / </text> @answer.MaxScore
                                }
                            </td>
                            <td>@(answer.CheckedBy ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-page="/Attempts/Index" class="btn btn-outline-secondary">Back to Attempts</a>
            <button type="submit" class="btn btn-primary">@(attempt.IsApproved ? "Re-approve" : "Approve Attempt")</button>
        </div>
    </form>
}
