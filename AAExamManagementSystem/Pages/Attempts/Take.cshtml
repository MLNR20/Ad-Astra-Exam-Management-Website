@page
@model AAExamManagementSystem.Pages.Attempts.TakeModel
@using AAExamManagementSystem.Models.Entities
@{
    ViewData["Title"] = "Take Exam";
    Layout = "_ExamLayout";
}

<div class="exam-sim-hero d-flex flex-column align-items-center justify-content-center text-center px-3">
    <div class="exam-sim-hero-overlay"></div>
    <div class="exam-sim-hero-content">
        <h1 class="exam-sim-hero-title text-white fw-bold mb-2">@(Model.SectionName ?? "Qualifying") Exam</h1>
        <p class="exam-sim-hero-subtitle text-white mb-0">Answer all 10 questions below. This exam can only be taken once.</p>
    </div>
</div>

<div class="py-5 px-3">
    <div class="mx-auto exam-sim-wrap">
        @if (!Model.HasApplicantProfile)
        {
            <div class="alert alert-warning">No applicant profile is linked to this account.</div>
            <a asp-page="/ApplicantPortal" class="btn btn-outline-secondary">Back to Applicant Portal</a>
        }
        else if (Model.AlreadyAttempted)
        {
            <div class="alert alert-info">
                @if (Model.SubmittedScore.HasValue)
                {
                    <p class="fs-5 mb-1">You scored @Model.SubmittedScore out of @Model.SubmittedMaxScore.</p>
                }
                <p class="mb-0">You have already taken this exam. Your attempt is awaiting review.</p>
            </div>
            <a asp-page="/ApplicantPortal" class="btn btn-outline-secondary">Back to Applicant Portal</a>
        }
        else if (Model.TotalPages == 0)
        {
            <p class="fs-5 mb-3">
                No active exam questions are available right now for your first choice
                (@(Model.FirstChoice ?? "not set")) or second choice (@(Model.SecondChoice ?? "not set")).
                Please check back later or contact Ad Astra.
            </p>
            <a asp-page="/ApplicantPortal" class="btn btn-outline-secondary">Back to Applicant Portal</a>
        }
        else
        {
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ExamError))
            {
                <div class="alert alert-danger">@Model.ExamError</div>
            }

            <form method="post" id="examForm">
                <input type="hidden" name="pageNum" value="@Model.CurrentPage" />
                @await Html.PartialAsync("_ExamQuestionHeader", (
                    Heading: "Multiple Choice",
                    Subheading: "Select one answer for each question, then continue.",
                    BadgeText: Model.TotalPages > 1 ? $"Page {Model.CurrentPage} of {Model.TotalPages}" : (string?)null))

                @for (var qi = 0; qi < Model.CurrentPageQuestions.Count; qi++)
                {
                    var question = Model.CurrentPageQuestions[qi];
                    var selectedChoiceId = Model.Answers.GetValueOrDefault(question.Id);
                    var existingText = Model.AnswerTexts.GetValueOrDefault(question.Id, string.Empty);
                    <div class="exam-sim-question mb-5 pb-4">
                        <h5 class="fw-semibold mb-2">@(qi + 1). @question.QuestionTitle</h5>
                        @if (QuestionTypes.RequiresChoices(question.QuestionTypeName))
                        {
                            <div class="exam-sim-choices mt-2">
                                @for (var ci = 0; ci < question.Choices.Count; ci++)
                                {
                                    var choice = question.Choices[ci];
                                    <div class="form-check exam-sim-choice mb-3">
                                        <input class="form-check-input" type="radio" name="Answers[@question.Id]" id="q@(qi)_c@(ci)" value="@choice.Id" required checked="@(choice.Id == selectedChoiceId)" />
                                        <label class="form-check-label" for="q@(qi)_c@(ci)">@choice.ChoiceText</label>
                                    </div>
                                }
                            </div>
                        }
                        else if (question.QuestionTypeName == QuestionTypes.Essay)
                        {
                            <textarea class="form-control" name="AnswerTexts[@question.Id]" rows="4" required>@existingText</textarea>
                        }
                        else
                        {
                            <input type="text" class="form-control" name="AnswerTexts[@question.Id]" value="@existingText" required />
                        }
                        @if (!string.IsNullOrEmpty(question.Image))
                        {
                            <img src="@question.Image" class="exam-sim-question-image img-fluid rounded mt-3 d-block mx-auto" alt="" />
                        }
                    </div>
                }

                <div class="d-flex justify-content-between mb-5">
                    @if (Model.CurrentPage > 1)
                    {
                        <button type="submit" name="direction" value="prev" formnovalidate class="btn btn-outline-secondary">Previous</button>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <button type="submit" name="direction" value="next" class="btn btn-primary">Next</button>
                    }
                    else
                    {
                        <button type="submit" name="direction" value="submit" class="btn btn-primary">Submit Answers</button>
                    }
                </div>

                <div class="alert alert-secondary">
                    <h2 class="h6 fw-bold mb-2">Instructions</h2>
                    <ul class="mb-0 ps-3">
                        <li>Answer every question on this page before continuing.</li>
                        <li>You can go back to a previous page to review your answers.</li>
                        <li>Once you submit the final page, your answers are final and cannot be changed.</li>
                        <li>This exam can only be taken once.</li>
                    </ul>
                </div>
            </form>
        }
    </div>
</div>

@section Styles {
    <style>
        .exam-sim-wrap {
            max-width: 720px;
            width: 100%;
        }

        .exam-sim-choice .form-check-input {
            border-color: #000;
        }

        .exam-sim-hero {
            position: relative;
            height: 43vh;
            background-image: url('@Url.Content("~/images/general-knowledge-banner.webp")');
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }

        .exam-sim-hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
        }

        .exam-sim-hero-content {
            position: relative;
            z-index: 1;
            max-width: 640px;
        }

        .exam-sim-hero-title {
            font-size: 2.75rem;
        }

        .exam-sim-hero-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
        }
    </style>
}
