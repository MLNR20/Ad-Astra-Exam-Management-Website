@page
@model AAExamManagementSystem.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "Roles";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "rolesTable",
    basePath = "/Roles",
    emptyMessage = "No roles found.",
    items = Model.Roles.Select(r => new EntityTableRow(r.Id, r.Name, r.IsActive, r.CreatedAt, DateUpdated: r.DateUpdated)),
    title = "Roles",
    addButtonText = "New Role",
    addButtonModalTarget = "#createRoleModal",
    showStatusColumn = true,
    showDateCreatedColumn = true,
    showDateUpdatedColumn = true,
    confirmDeleteWithSweetAlert = true,
    confirmCreateWithSweetAlert = true,
    entityName = "Role",
    useSoftDelete = true
})

<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" class="js-sweetalert-create-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="createRoleModalLabel">New Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewRole.Name" class="form-label"></label>
                        <input asp-for="NewRole.Name" class="form-control" />
                        <span asp-validation-for="NewRole.Name" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="NewRole.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="NewRole.IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/sweetalert-toast.js" asp-append-version="true"></script>
    <partial name="_SuccessToast" />
    <script>
        $(function () {
            if ($('#rolesTable').length) {
                initEntityTable('rolesTable');
            }
            @if (Model.ShowCreateModal)
            {
                <text>new bootstrap.Modal(document.getElementById('createRoleModal')).show();</text>
            }
        });
    </script>
}
