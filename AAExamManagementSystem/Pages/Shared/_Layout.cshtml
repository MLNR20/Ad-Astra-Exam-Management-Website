@using AAExamManagementSystem.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity != null && User.Identity.IsAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;
    var userInitial = currentUser != null && !string.IsNullOrEmpty(currentUser.FirstName)
        ? currentUser.FirstName.Substring(0, 1).ToUpperInvariant()
        : "?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Exam Management System</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AAExamManagementSystem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <div class="d-flex">
        @await Html.PartialAsync("_Sidebar")
        <div class="flex-grow-1 d-flex flex-column min-vh-100 overflow-x-auto main-content">
            <header>
                <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-outline-secondary" type="button" id="sidebarToggle"
                                    aria-label="Toggle sidebar" aria-expanded="true" aria-controls="sidebar">
                                <i class="bi bi-list" aria-hidden="true"></i>
                            </button>
                            @if (currentUser != null)
                            {
                                <span class="fw-semibold">Welcome, @currentUser.FirstName @currentUser.LastName</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span id="currentTime" class="text-muted fw-semibold"></span>
                            <form method="post" asp-area="" asp-page="/Logout">
                                <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center fw-semibold border-0"
                                        style="width: 38px; height: 38px;" aria-label="Logout" title="Logout">
                                    @userInitial
                                </button>
                            </form>
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary rounded-circle position-relative d-flex align-items-center justify-content-center border-0"
                                        style="width: 38px; height: 38px;" aria-label="Notifications"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell-fill" aria-hidden="true"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none">
                                        <span class="visually-hidden">New notifications</span>
                                    </span>
                                </button>
                                <div id="notificationList" class="dropdown-menu dropdown-menu-end p-2" style="min-width: 320px; max-height: 400px; overflow-y: auto;">
                                    <span data-empty-state class="dropdown-item-text text-muted small">No notifications yet.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
            <div class="container-fluid p-4 flex-grow-1">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted bg-white">
                <div class="container-fluid">
                    &copy; 2026 - Exam Management System - <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/clock.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
