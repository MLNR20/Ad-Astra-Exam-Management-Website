@model (bool isActive, string activeText, string inactiveText)

<span class="d-inline-flex align-items-center gap-2">
    <span class="status-dot @(Model.isActive ? "status-dot-active" : "status-dot-inactive")" aria-hidden="true"></span>
    @(Model.isActive ? Model.activeText : Model.inactiveText)
</span>
