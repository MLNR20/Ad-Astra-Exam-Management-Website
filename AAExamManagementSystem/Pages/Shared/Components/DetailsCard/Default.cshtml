@model AAExamManagementSystem.ViewComponents.DetailsCardViewModel

<div class="card border rounded-2 p-3">
    <div class="card-header bg-white border-bottom-0">
        <h5 class="mb-0" style="font-size: 1.2rem;">@Model.Title</h5>
        <hr class="w-100 mt-3 mb-0" />
    </div>
    <div class="card-body">
        <div class="row">
            <div class="@Model.ColumnClass">
                <dl class="row mb-0">
                    @foreach (var field in Model.Fields)
                    {
                        <dt class="col-sm-4">@field.Label</dt>
                        <dd class="col-sm-8">@field.Value</dd>
                    }
                    @if (Model.ShowStatus)
                    {
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@await Component.InvokeAsync("StatusPill", new { isActive = Model.IsActive })</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <a href="@Model.EditHref" class="btn btn-primary">Edit</a>
            <a href="@Model.BackHref" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
