@using AAExamManagementSystem.Models.Entities
<nav id="sidebar" class="sidebar flex-shrink-0 bg-white border-end">
    <div class="sidebar-inner d-flex flex-column h-100 p-3">
        <a asp-area="" asp-page="/Index" class="d-flex align-items-center mb-3 text-dark text-decoration-none">
            <span class="fs-5 fw-semibold">EMS Dashboard</span>
        </a>
        <hr>

        @if (User.IsInRole(Roles.Applicant))
        {
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-area="" asp-page="/ApplicantPortal" class="nav-link text-dark sidebar-link"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i> Applicant Portal</a>
                </li>
            </ul>
        }
        else
        {
            <ul class="nav nav-pills flex-column">
                <li class="nav-item">
                    <a asp-area="" asp-page="/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-area="" asp-page="/Analytics/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i> Analytics</a>
                </li>
            </ul>

            <div class="sidebar-heading text-uppercase text-muted small fw-semibold mt-3 mb-1 px-2">Academics</div>
            <ul class="nav nav-pills flex-column">
                <li class="nav-item">
                    <a asp-area="" asp-page="/Departments/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-building-fill" aria-hidden="true"></i> Departments</a>
                </li>
                <li class="nav-item">
                    <a asp-area="" asp-page="/Sections/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i> Sections</a>
                </li>
                <li class="nav-item">
                    <a asp-area="" asp-page="/Courses/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i> Courses</a>
                </li>
                <li class="nav-item">
                    <a asp-area="" asp-page="/Questions/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-question-circle-fill" aria-hidden="true"></i> Questions &amp; Choices</a>
                </li>
            </ul>

            <div class="sidebar-heading text-uppercase text-muted small fw-semibold mt-3 mb-1 px-2">Administration</div>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-area="" asp-page="/Users/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-people-fill" aria-hidden="true"></i> Users</a>
                </li>
                <li class="nav-item">
                    <a asp-area="" asp-page="/Roles/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-person-badge-fill" aria-hidden="true"></i> Roles</a>
                </li>
                @if (User.IsInRole(Roles.Admin))
                {
                    <li class="nav-item">
                        <a asp-area="" asp-page="/AuditLogs/Index" class="nav-link text-dark sidebar-link"><i class="bi bi-clipboard-data-fill" aria-hidden="true"></i> Audit Logs</a>
                    </li>
                }
            </ul>
        }

        <hr>
        <form method="post" asp-area="" asp-page="/Logout">
            <button type="submit" class="nav-link text-danger sidebar-link w-100 text-start border-0 bg-transparent px-3 py-2">
                <i class="bi bi-box-arrow-left" aria-hidden="true"></i> Logout
            </button>
        </form>
    </div>
</nav>
