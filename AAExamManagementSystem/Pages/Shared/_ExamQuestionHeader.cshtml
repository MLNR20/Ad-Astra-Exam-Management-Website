@model (string Heading, string Subheading, string? BadgeText)

<div class="d-flex flex-wrap justify-content-between align-items-end gap-4 mb-4">
    <div class="d-flex flex-column gap-3">
        <h4 class="exam-question-header fw-extrabold mb-0">@Model.Heading</h4>
        <h5 class="exam-question-subheader text-muted fw-normal mb-0">@Model.Subheading</h5>
    </div>
    @if (!string.IsNullOrEmpty(Model.BadgeText))
    {
        <span class="badge bg-primary rounded-pill">@Model.BadgeText</span>
    }
</div>
