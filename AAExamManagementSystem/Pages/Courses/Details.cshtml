@page "{id:int}"
@model AAExamManagementSystem.Pages.Courses.DetailsModel
@{
    ViewData["Title"] = "Course Details";
}

@await Component.InvokeAsync("DetailsCard", new
{
    title = "Course Details",
    fields = new[]
    {
        new DetailsField("Id", Model.Course.Id.ToString()),
        new DetailsField("Name", Model.Course.Name),
        new DetailsField("School Name", Model.Course.SchoolName ?? "-"),
        new DetailsField("Date Created", Model.Course.CreatedAt.ToString("MMM d, yyyy")),
        new DetailsField("Date Updated", Model.Course.DateUpdated.ToString("MMM d, yyyy"))
    },
    showStatus = true,
    isActive = Model.Course.IsActive,
    editHref = $"/Courses/Edit/{Model.Course.Id}",
    backHref = "/Courses"
})
