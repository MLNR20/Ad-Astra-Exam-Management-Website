@page
@model ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Exam Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="login-page d-flex align-items-center justify-content-center min-vh-100 p-3">
        <div class="card login-card border-0 shadow-sm w-100">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="login-logo mx-auto mb-3">
                        <i class="bi bi-key" aria-hidden="true"></i>
                    </div>
                    <h1 class="h4 fw-bold mb-1">Forgot your password?</h1>
                    <p class="text-muted mb-0">Enter your email and we'll help you reset it</p>
                </div>

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-send me-1" aria-hidden="true"></i> Send Reset Link
                    </button>

                    <p class="text-center text-muted small mt-3 mb-0">
                        <a asp-page="/Login"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Login</a>
                    </p>
                </form>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
