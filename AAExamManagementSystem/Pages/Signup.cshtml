@page
@model SignupModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Applicant Registration - Exam Management System</title>
    <link rel="icon" type="image/png" href="~/images/adastra-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-light bg-white shadow-sm mb-0 site-navbar">
        <div class="container-fluid d-flex align-items-center justify-content-between px-5">
            <a asp-page="/Index" class="navbar-brand d-flex align-items-center gap-2 mb-0">
                <img src="~/images/adastra-mark.png" alt="" class="signup-navbar-mark" />
                <span class="fw-semibold">AD ASTRA</span>
            </a>
            <a asp-page="/ApplicantLogin" class="btn btn-dark fw-semibold">Login</a>
        </div>
    </nav>
    <main class="login-page d-flex align-items-center justify-content-center flex-grow-1 p-3">
        <div class="signup-wizard-wrapper w-100">
            <div class="text-start px-2 px-md-3 pt-8 pb-1">
                <h1 class="h4 fw-bold mb-3">Applicant Registration</h1>
                <p class="text-muted mb-0">Create your account and submit your application</p>
            </div>

            <div class="container-fluid mt-4">
                <div class="signup-steps pb-2 ps-0 pe-2 pe-md-3">
                    <span class="fw-semibold" id="signupStepCounter" style="font-size: 1.2rem;">Step 1 of 3</span>
                </div>
                <hr />
            </div>

            <div class="signup-wizard-card w-100">
                <div>
                <form method="post" id="signupForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mx-4 mx-md-5" role="alert"></div>

                    <div class="row g-0">
                        <div class="col-12 px-2 px-md-3 pt-2 pb-8">
                            <div class="signup-panel" data-panel="1">
                                <h2 class="h6 text-uppercase text-muted fw-semibold mb-3 mt-3">Account Information</h2>
                                <div class="row">
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.UserName" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.UserName" class="form-control" autocomplete="username" autofocus />
                                        <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.FirstName" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.FirstName" class="form-control" />
                                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.LastName" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.LastName" class="form-control" />
                                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="signup-panel d-none" data-panel="2">
                                <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">Academic Information</h2>
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.StudentNo" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.StudentNo" class="form-control" />
                                        <span asp-validation-for="Input.StudentNo" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.AcademicYear" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.AcademicYear" class="form-control" placeholder="e.g. 2026-2027" />
                                        <span asp-validation-for="Input.AcademicYear" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.YearLevel" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.YearLevel" class="form-control" />
                                        <span asp-validation-for="Input.YearLevel" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.School" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.School" class="form-control" />
                                        <span asp-validation-for="Input.School" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.FirstChoice" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.FirstChoice" class="form-control" />
                                        <span asp-validation-for="Input.FirstChoice" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.SecondChoice" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.SecondChoice" class="form-control" />
                                        <span asp-validation-for="Input.SecondChoice" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.ExpectedGradDate" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.ExpectedGradDate" class="form-control" />
                                        <span asp-validation-for="Input.ExpectedGradDate" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label asp-for="Input.TermsRemaining" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.TermsRemaining" class="form-control" type="number" min="0" />
                                        <span asp-validation-for="Input.TermsRemaining" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <div class="form-check">
                                            <input asp-for="Input.IsScholar" class="form-check-input" />
                                            <label asp-for="Input.IsScholar" class="form-check-label"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="signup-panel d-none" data-panel="3">
                                <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">Submission</h2>
                                <div class="row">
                                    <div class="col-12 mb-4">
                                        <label asp-for="Input.Resume" class="form-label fw-semibold"></label>
                                        <input asp-for="Input.Resume" class="form-control" placeholder="Link to your resume (optional)" />
                                        <span asp-validation-for="Input.Resume" class="text-danger small"></span>
                                    </div>
                                </div>

                                <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">Review Your Application</h2>
                                <div class="signup-summary-card">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Username</dt>
                                        <dd class="col-sm-7" id="summary-username">&mdash;</dd>

                                        <dt class="col-sm-5">Email</dt>
                                        <dd class="col-sm-7" id="summary-email">&mdash;</dd>

                                        <dt class="col-sm-5">Full Name</dt>
                                        <dd class="col-sm-7" id="summary-fullname">&mdash;</dd>

                                        <dt class="col-sm-5">Student No.</dt>
                                        <dd class="col-sm-7" id="summary-studentno">&mdash;</dd>

                                        <dt class="col-sm-5">Academic Year</dt>
                                        <dd class="col-sm-7" id="summary-academicyear">&mdash;</dd>

                                        <dt class="col-sm-5">Year Level</dt>
                                        <dd class="col-sm-7" id="summary-yearlevel">&mdash;</dd>

                                        <dt class="col-sm-5">School</dt>
                                        <dd class="col-sm-7" id="summary-school">&mdash;</dd>

                                        <dt class="col-sm-5">First Choice</dt>
                                        <dd class="col-sm-7" id="summary-firstchoice">&mdash;</dd>

                                        <dt class="col-sm-5">Second Choice</dt>
                                        <dd class="col-sm-7" id="summary-secondchoice">&mdash;</dd>

                                        <dt class="col-sm-5">Scholar</dt>
                                        <dd class="col-sm-7" id="summary-scholar">&mdash;</dd>
                                    </dl>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 mt-5">
                                <button type="button" class="btn btn-outline-secondary btn-lg px-4 signup-prev d-none">
                                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Back
                                </button>
                                <button type="button" class="btn btn-dark btn-lg px-4 signup-next">
                                    Next <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                </button>
                                <button type="submit" class="btn btn-primary btn-lg px-4 d-none signup-submit">
                                    <i class="bi bi-send-check me-1" aria-hidden="true"></i> Submit Application
                                </button>
                            </div>

                            <p class="text-start text-muted fs-5 mt-4 mb-0">
                                Already have an account? <a asp-page="/ApplicantLogin">Login</a>
                            </p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        </div>
    </main>

    @await Html.PartialAsync("_AdAstraFooter")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var totalSteps = 3;
            var current = 1;
            var panels = document.querySelectorAll('.signup-panel');
            var stepCounter = document.getElementById('signupStepCounter');
            var nextBtn = document.querySelector('.signup-next');
            var prevBtn = document.querySelector('.signup-prev');
            var submitBtn = document.querySelector('.signup-submit');

            function showStep(step) {
                panels.forEach(function (p) { p.classList.toggle('d-none', Number(p.dataset.panel) !== step); });
                stepCounter.textContent = 'Step ' + step + ' of ' + totalSteps;
                prevBtn.classList.toggle('d-none', step === 1);
                nextBtn.classList.toggle('d-none', step === totalSteps);
                submitBtn.classList.toggle('d-none', step !== totalSteps);
                current = step;
                if (step === totalSteps) {
                    updateSummary();
                }
                document.querySelector('.signup-wizard-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function validateStep(step) {
                var panel = document.querySelector('.signup-panel[data-panel="' + step + '"]');
                var valid = true;
                panel.querySelectorAll('input, select, textarea').forEach(function (input) {
                    if (window.jQuery && window.jQuery(input).valid) {
                        if (!window.jQuery(input).valid()) {
                            valid = false;
                        }
                    } else if (!input.checkValidity()) {
                        input.reportValidity();
                        valid = false;
                    }
                });
                return valid;
            }

            function fieldValue(id) {
                var el = document.getElementById(id);
                return el ? el.value : '';
            }

            function updateSummary() {
                document.getElementById('summary-username').textContent = fieldValue('Input_UserName') || '—';
                document.getElementById('summary-email').textContent = fieldValue('Input_Email') || '—';
                var fullName = (fieldValue('Input_FirstName') + ' ' + fieldValue('Input_LastName')).trim();
                document.getElementById('summary-fullname').textContent = fullName || '—';
                document.getElementById('summary-studentno').textContent = fieldValue('Input_StudentNo') || '—';
                document.getElementById('summary-academicyear').textContent = fieldValue('Input_AcademicYear') || '—';
                document.getElementById('summary-yearlevel').textContent = fieldValue('Input_YearLevel') || '—';
                document.getElementById('summary-school').textContent = fieldValue('Input_School') || '—';
                document.getElementById('summary-firstchoice').textContent = fieldValue('Input_FirstChoice') || '—';
                document.getElementById('summary-secondchoice').textContent = fieldValue('Input_SecondChoice') || '—';
                var scholarEl = document.getElementById('Input_IsScholar');
                document.getElementById('summary-scholar').textContent = (scholarEl && scholarEl.checked) ? 'Yes' : 'No';
            }

            nextBtn.addEventListener('click', function () {
                if (!validateStep(current)) return;
                if (current < totalSteps) showStep(current + 1);
            });

            prevBtn.addEventListener('click', function () {
                if (current > 1) showStep(current - 1);
            });
        })();
    </script>
</body>
</html>
