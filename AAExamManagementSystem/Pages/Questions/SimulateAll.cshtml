@page
@model AAExamManagementSystem.Pages.Questions.SimulateAllModel
@{
    ViewData["Title"] = "Exam Simulation";
    Layout = "_ExamLayout";
}

<div class="exam-sim-hero d-flex flex-column align-items-center justify-content-center text-center px-3">
    <div class="exam-sim-hero-overlay"></div>
    <div class="exam-sim-hero-content">
        @if (Model.HasPreviousPage)
        {
            <h1 class="exam-sim-hero-title text-white fw-bold mb-2">SQL Queries</h1>
            <p class="exam-sim-hero-subtitle text-white mb-0">Write the SQL query that answers each question about the schema shown.</p>
        }
        else
        {
            <h1 class="exam-sim-hero-title text-white fw-bold mb-2">General Knowledge</h1>
            <p class="exam-sim-hero-subtitle text-white mb-0">This section aims to gauge your familiarity in programming and development concepts.</p>
        }
    </div>
</div>

<div class="py-5 px-3">
    <div class="mx-auto exam-sim-wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-4 mb-4">
            <div>
                <h4 class="fw-bold mb-1">@(Model.HasPreviousPage ? "SQL Query Questions" : "Multiple Choice Questions")</h4>
                <h5 class="text-muted fw-normal mb-0">Answer every question below, then submit to see your score.</h5>
            </div>
            @if (Model.Questions.Count > 0)
            {
                <span class="badge bg-primary rounded-pill">@Model.Questions.Sum(q => q.Score) pt(s) total</span>
            }
        </div>

        @if (Model.Questions.Count == 0)
        {
            <p class="fs-5 mb-3">No active multiple choice questions available to simulate.</p>
            <a href="/Questions" class="btn btn-outline-secondary">Back to Questions</a>
        }
        else
        {
            @for (var qi = 0; qi < Model.Questions.Count; qi++)
            {
                var question = Model.Questions[qi];
                var isIdentification = question.QuestionTypeName == AAExamManagementSystem.Models.Entities.QuestionTypes.Identification;
                <div class="exam-sim-question mb-4 pb-4 border-bottom" data-question-index="@qi" data-question-type="@question.QuestionTypeName">
                    <h5 class="fw-semibold mb-2">
                        @(qi + 1). @question.QuestionTitle
                    </h5>
                    <div class="exam-sim-choices">
                        @if (isIdentification)
                        {
                            var correctAnswer = question.Choices.FirstOrDefault(c => c.IsCorrect)?.ChoiceText ?? string.Empty;
                            var isSqlQuestion = question.Image != null && question.Image.Contains("sql-schema");
                            var inputPlaceholder = isSqlQuestion ? "Type your SQL query" : "Type the programming language name";
                            var inputClass = isSqlQuestion ? "form-control exam-sim-input exam-sim-input-sql" : "form-control exam-sim-input";
                            <input type="text" class="@inputClass" name="q@(qi)" id="q@(qi)_input" data-answer="@correctAnswer" placeholder="@inputPlaceholder" autocomplete="off" />
                        }
                        else
                        {
                            @for (var ci = 0; ci < question.Choices.Count; ci++)
                            {
                                var choice = question.Choices[ci];
                                <div class="form-check exam-sim-choice mb-2">
                                    <input class="form-check-input" type="radio" name="q@(qi)" id="q@(qi)_c@(ci)" data-correct="@choice.IsCorrect.ToString().ToLowerInvariant()" />
                                    <label class="form-check-label" for="q@(qi)_c@(ci)">@choice.ChoiceText</label>
                                </div>
                            }
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(question.Image))
                    {
                        var isSqlSchemaImage = question.Image.Contains("sql-schema");
                        var imageClass = isSqlSchemaImage
                            ? "exam-sim-question-image exam-sim-question-image-wide img-fluid rounded mt-3 d-block mx-auto"
                            : "exam-sim-question-image img-fluid rounded mt-3 d-block mx-auto";
                        <img src="@question.Image" class="@imageClass" alt="" />
                    }
                    <div class="exam-sim-result mt-2" id="result@(qi)"></div>
                </div>
            }
            <div id="simSummary" class="d-none text-center mb-4"></div>

            <div class="d-flex justify-content-between mb-5">
                @if (Model.HasPreviousPage)
                {
                    <a href="?PageNumber=1" class="btn btn-outline-secondary">Previous</a>
                }
                else
                {
                    <a href="/Questions" class="btn btn-outline-secondary">Exit Preview</a>
                }
                <button type="button" id="submitAllSim" class="btn btn-primary">Submit All Answers</button>
            </div>

            <div class="alert alert-secondary">
                <h2 class="h6 fw-bold mb-2">Instructions</h2>
                <ul class="mb-0 ps-3">
                    <li>Select exactly one answer for each question.</li>
                    <li>All questions must be answered before you can submit.</li>
                    <li>Once you submit, your answers are final and cannot be changed.</li>
                    <li>Each question's point value is shown next to its title.</li>
                </ul>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .exam-sim-wrap {
            max-width: 720px;
            width: 100%;
        }

        .exam-sim-question-image {
            width: 33%;
        }

        .exam-sim-question-image-wide {
            width: 100%;
            max-width: 560px;
        }

        .exam-sim-choice .form-check-input,
        .exam-sim-input {
            border-color: #000;
        }

        .exam-sim-input {
            max-width: 320px;
        }

        .exam-sim-hero {
            position: relative;
            height: 43vh;
            background-image: url('@Url.Content("~/images/general-knowledge-banner.webp")');
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }

        .exam-sim-hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
        }

        .exam-sim-hero-content {
            position: relative;
            z-index: 1;
            max-width: 640px;
        }

        .exam-sim-hero-title {
            font-size: 2.75rem;
        }

        .exam-sim-hero-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
        }
    </style>
}

@if (Model.Questions.Count > 0)
{
    @section Scripts {
        <script>
            (function () {
                var questionCount = @Model.Questions.Count;
                var hasNextPage = @Json.Serialize(Model.HasNextPage);
                var submitBtn = document.getElementById('submitAllSim');
                var summaryEl = document.getElementById('simSummary');
                var submitted = false;

                function questionType(qi) {
                    var el = document.querySelector('.exam-sim-question[data-question-index="' + qi + '"]');
                    return el ? el.dataset.questionType : '';
                }

                function normalizeAnswer(value) {
                    return value.trim().replace(/;+$/, '').replace(/\s+/g, ' ').toLowerCase();
                }

                submitBtn.addEventListener('click', function () {
                    if (submitted) {
                        return;
                    }

                    var unanswered = [];
                    for (var qi = 0; qi < questionCount; qi++) {
                        if (questionType(qi) === 'Identification') {
                            var input = document.getElementById('q' + qi + '_input');
                            if (!input.value.trim()) {
                                unanswered.push(qi + 1);
                            }
                        } else if (!document.querySelector('input[name="q' + qi + '"]:checked')) {
                            unanswered.push(qi + 1);
                        }
                    }
                    if (unanswered.length > 0) {
                        summaryEl.classList.remove('d-none');
                        summaryEl.innerHTML = '<div class="alert alert-warning mb-0">Answer question(s) ' + unanswered.join(', ') + ' before submitting.</div>';
                        return;
                    }

                    submitted = true;
                    var score = 0;
                    for (var i = 0; i < questionCount; i++) {
                        var resultEl = document.getElementById('result' + i);
                        var isCorrect;

                        if (questionType(i) === 'Identification') {
                            var input = document.getElementById('q' + i + '_input');
                            isCorrect = normalizeAnswer(input.value) === normalizeAnswer(input.dataset.answer || '');
                            input.readOnly = true;
                        } else {
                            var selected = document.querySelector('input[name="q' + i + '"]:checked');
                            isCorrect = selected.dataset.correct === 'true';
                        }

                        if (isCorrect) {
                            score++;
                        }
                        resultEl.innerHTML = isCorrect
                            ? '<div class="alert alert-success mb-0">Correct!</div>'
                            : '<div class="alert alert-danger mb-0">Incorrect.</div>';
                    }

                    submitBtn.classList.add('d-none');
                    summaryEl.classList.remove('d-none');
                    var nextAction = hasNextPage
                        ? '<a href="?PageNumber=2" class="btn btn-primary">Continue to SQL Questions</a>'
                        : '<a href="/Questions" class="btn btn-primary">Back to Questions</a>';
                    summaryEl.innerHTML = '<p class="fs-5">You answered ' + score + ' out of ' + questionCount + ' correctly.</p>' +
                        nextAction;
                });
            })();
        </script>
    }
}
