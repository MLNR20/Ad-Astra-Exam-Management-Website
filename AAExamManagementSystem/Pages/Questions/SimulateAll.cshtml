@page
@model AAExamManagementSystem.Pages.Questions.SimulateAllModel
@{
    ViewData["Title"] = "Exam Simulation";
    Layout = "_ExamLayout";
}

<div class="d-flex justify-content-center py-5 px-3">
    @if (Model.Questions.Count == 0)
    {
        <div class="card border rounded-3 shadow-sm exam-sim-card">
            <div class="card-body text-center py-5">
                <p class="fs-5 mb-3">No active questions available to simulate.</p>
                <a href="/Questions" class="btn btn-outline-secondary">Back to Questions</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border rounded-3 shadow-sm exam-sim-card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold" id="simProgress"></span>
                <span class="badge bg-primary" id="simScoreBadge"></span>
            </div>
            <div class="card-body">
                <div id="simImageWrap"></div>
                <p class="fs-5" id="simTitle"></p>
                <div id="simChoices"></div>
                <div id="simResult" class="mt-3"></div>
                <div id="simSummary" class="d-none text-center"></div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a href="/Questions" class="btn btn-outline-secondary">Exit Preview</a>
                <div>
                    <button type="button" id="submitSim" class="btn btn-primary">Submit Answer</button>
                    <button type="button" id="nextSim" class="btn btn-primary d-none">Next Question</button>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .exam-sim-card {
            max-width: 720px;
            width: 100%;
            border-radius: 1rem;
        }
    </style>
}

@if (Model.Questions.Count > 0)
{
    @section Scripts {
        <script id="simQuestionsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Questions.Select(q => new
                                                                {
                                                                    q.QuestionTitle,
                                                                    q.Image,
                                                                    q.Score,
                                                                    Choices = q.Choices.Select(c => new { c.ChoiceText, c.IsCorrect })
                                                                }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
        <script>
            (function () {
                var questions = JSON.parse(document.getElementById('simQuestionsData').textContent);
                var currentIndex = 0;
                var score = 0;
                var answered = false;

                var progressEl = document.getElementById('simProgress');
                var scoreBadgeEl = document.getElementById('simScoreBadge');
                var imageWrapEl = document.getElementById('simImageWrap');
                var titleEl = document.getElementById('simTitle');
                var choicesEl = document.getElementById('simChoices');
                var resultEl = document.getElementById('simResult');
                var summaryEl = document.getElementById('simSummary');
                var submitBtn = document.getElementById('submitSim');
                var nextBtn = document.getElementById('nextSim');

                function renderQuestion() {
                    var question = questions[currentIndex];
                    answered = false;
                    resultEl.innerHTML = '';
                    progressEl.textContent = 'Question ' + (currentIndex + 1) + ' of ' + questions.length;
                    scoreBadgeEl.textContent = question.score + ' pt' + (question.score === 1 ? '' : 's');

                    imageWrapEl.innerHTML = question.image
                        ? '<img src="' + question.image + '" class="img-fluid rounded mb-3" alt="" />'
                        : '';
                    titleEl.textContent = question.questionTitle;

                    choicesEl.innerHTML = '';
                    question.choices.forEach(function (choice, i) {
                        var wrap = document.createElement('div');
                        wrap.className = 'form-check exam-sim-choice mb-2';
                        wrap.innerHTML = '<input class="form-check-input" type="radio" name="choice" id="choice' + i + '" data-correct="' + choice.isCorrect + '">' +
                            '<label class="form-check-label" for="choice' + i + '"></label>';
                        wrap.querySelector('label').textContent = choice.choiceText;
                        choicesEl.appendChild(wrap);
                    });

                    submitBtn.classList.remove('d-none');
                    nextBtn.classList.add('d-none');
                }

                function showSummary() {
                    progressEl.textContent = 'Simulation Complete';
                    scoreBadgeEl.textContent = '';
                    imageWrapEl.innerHTML = '';
                    titleEl.textContent = '';
                    choicesEl.innerHTML = '';
                    resultEl.innerHTML = '';
                    submitBtn.classList.add('d-none');
                    nextBtn.classList.add('d-none');
                    summaryEl.classList.remove('d-none');
                    summaryEl.innerHTML = '<p class="fs-5">You answered ' + score + ' out of ' + questions.length + ' correctly.</p>' +
                        '<a href="/Questions" class="btn btn-primary">Back to Questions</a>';
                }

                submitBtn.addEventListener('click', function () {
                    if (answered) {
                        return;
                    }
                    var selected = choicesEl.querySelector('input[name="choice"]:checked');
                    if (!selected) {
                        resultEl.innerHTML = '<div class="alert alert-warning mb-0">Select an answer first.</div>';
                        return;
                    }
                    answered = true;
                    var isCorrect = selected.dataset.correct === 'true';
                    if (isCorrect) {
                        score++;
                    }
                    resultEl.innerHTML = isCorrect
                        ? '<div class="alert alert-success mb-0">Correct!</div>'
                        : '<div class="alert alert-danger mb-0">Incorrect.</div>';

                    submitBtn.classList.add('d-none');
                    nextBtn.classList.remove('d-none');
                    nextBtn.textContent = currentIndex === questions.length - 1 ? 'Finish' : 'Next Question';
                });

                nextBtn.addEventListener('click', function () {
                    currentIndex++;
                    if (currentIndex >= questions.length) {
                        showSummary();
                    } else {
                        renderQuestion();
                    }
                });

                renderQuestion();
            })();
        </script>
    }
}
