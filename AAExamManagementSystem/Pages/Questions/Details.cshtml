@page "{id:guid}"
@model AAExamManagementSystem.Pages.Questions.DetailsModel
@{
    ViewData["Title"] = "Question Details";

    var fields = new List<DetailsField>
    {
        new("Question Type", Model.Question.QuestionTypeName),
        new("Section", Model.Question.SectionName),
        new("Question Title", Model.Question.QuestionTitle),
        new("Score", Model.Question.Score.ToString()),
        new("Up for Evaluation", Model.Question.IsUpToEvaluation ? "Yes" : "No")
    };

    if (!string.IsNullOrWhiteSpace(Model.Question.Image))
    {
        fields.Add(new DetailsField("Image", Model.Question.Image));
    }
}

<div class="card border rounded-2 p-3">
    <div class="card-header bg-white border-bottom-0">
        <h5 class="mb-0" style="font-size: 1.2rem;">Question Details</h5>
        <hr class="w-100 mt-3 mb-0" />
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row mb-0">
                    @foreach (var field in fields)
                    {
                        <dt class="col-sm-4">@field.Label</dt>
                        <dd class="col-sm-8">@field.Value</dd>
                    }
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@await Component.InvokeAsync("StatusPill", new { isActive = Model.Question.IsActive })</dd>
                </dl>
            </div>
        </div>

        @if (Model.Question.Choices.Any())
        {
            <hr class="w-100 my-3" />
            <div>
                <div class="fw-semibold mb-2">Choices</div>
                <ul class="list-group list-group-flush">
                    @for (var i = 0; i < Model.Question.Choices.Count; i++)
                    {
                        var choice = Model.Question.Choices[i];
                        <li class="list-group-item d-flex justify-content-between align-items-center @(choice.IsCorrect ? "list-group-item-success border-0 rounded-2 my-1" : "")">
                            <span><strong class="me-2">@((char)('A' + i)).</strong>@choice.ChoiceText</span>
                            @if (choice.IsCorrect)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-lg" aria-hidden="true"></i> Correct</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        <div class="d-flex gap-2 mt-3">
            <a href="/Questions/Edit/@Model.Question.Id" class="btn btn-primary">Edit</a>
            <a href="/Questions" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
