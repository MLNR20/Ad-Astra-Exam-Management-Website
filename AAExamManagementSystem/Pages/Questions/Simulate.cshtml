@page "{id:guid}"
@model AAExamManagementSystem.Pages.Questions.SimulateModel
@{
    ViewData["Title"] = "Exam Simulation";
    Layout = "_ExamLayout";
}

<div class="d-flex justify-content-center py-5 px-3">
    <div class="card border rounded-3 shadow-sm exam-sim-card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Question Preview</span>
            <span class="badge bg-primary">@Model.Question.Score pt@(Model.Question.Score == 1 ? "" : "s")</span>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Question.Image))
            {
                <img src="@Model.Question.Image" class="img-fluid rounded mb-3" alt="" />
            }
            <p class="fs-5 mb-1">@Model.Question.QuestionTitle</p>

            <div id="simChoices">
                @for (var i = 0; i < Model.Question.Choices.Count; i++)
                {
                    var choice = Model.Question.Choices[i];
                    <div class="form-check exam-sim-choice mb-2">
                        <input class="form-check-input" type="radio" name="choice" id="choice@(i)" data-correct="@choice.IsCorrect.ToString().ToLowerInvariant()" />
                        <label class="form-check-label" for="choice@(i)">@choice.ChoiceText</label>
                    </div>
                }
            </div>

            <div id="simResult" class="mt-3"></div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between">
            <a href="/Questions" class="btn btn-outline-secondary">Exit Preview</a>
            <button type="button" id="submitSim" class="btn btn-primary">Submit Answer</button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .exam-sim-card {
            max-width: 720px;
            width: 100%;
            border-radius: 1rem;
        }
    </style>
}

@section Scripts {
    <script>
        document.getElementById('submitSim').addEventListener('click', function () {
            var selected = document.querySelector('#simChoices input[name="choice"]:checked');
            var result = document.getElementById('simResult');
            if (!selected) {
                result.innerHTML = '<div class="alert alert-warning mb-0">Select an answer first.</div>';
                return;
            }
            var isCorrect = selected.dataset.correct === 'true';
            result.innerHTML = isCorrect
                ? '<div class="alert alert-success mb-0">Correct!</div>'
                : '<div class="alert alert-danger mb-0">Incorrect.</div>';
        });
    </script>
}
