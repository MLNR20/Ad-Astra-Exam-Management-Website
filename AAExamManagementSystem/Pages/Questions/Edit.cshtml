@page "{id:guid}"
@model AAExamManagementSystem.Pages.Questions.EditModel
@{
    ViewData["Title"] = "Edit Question";
}

<edit-card title="Edit Question">
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Question.QuestionTypeId" class="form-label"></label>
                    <select asp-for="Question.QuestionTypeId" class="form-select" asp-items="Model.QuestionTypeOptions">
                        <option value="">-- Select Question Type --</option>
                    </select>
                    <span asp-validation-for="Question.QuestionTypeId" class="text-danger"></span>
                </div>
                <partial name="_ChoicesEditor" model="new ChoicesEditorModel(nameof(Model.Question), Model.Question.Choices, Model.ChoiceTypeIds)" />
                @if (Model.IsAdmin)
                {
                    <div class="mb-3">
                        <label asp-for="Question.SectionId" class="form-label"></label>
                        <select asp-for="Question.SectionId" class="form-select" asp-items="Model.SectionOptions">
                            <option value="">-- Select Section --</option>
                        </select>
                        <span asp-validation-for="Question.SectionId" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Question.SectionId" />
                    <div class="mb-3">
                        <label class="form-label">Section</label>
                        <input type="text" class="form-control" value="@Model.CurrentUserSectionName" disabled />
                        <div class="form-text">Editors can only edit questions within their assigned department.</div>
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="Question.QuestionTitle" class="form-label"></label>
                    <textarea asp-for="Question.QuestionTitle" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Question.QuestionTitle" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Question.Image" class="form-label"></label>
                    <input asp-for="Question.Image" class="form-control" placeholder="Image URL (optional)" />
                    <span asp-validation-for="Question.Image" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Question.Score" class="form-label"></label>
                    <input asp-for="Question.Score" class="form-control" type="number" />
                    <span asp-validation-for="Question.Score" class="text-danger"></span>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="Question.IsUpToEvaluation" class="form-check-input" role="switch" />
                    <label asp-for="Question.IsUpToEvaluation" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="Question.IsActive" class="form-check-input" role="switch" />
                    <label asp-for="Question.IsActive" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</edit-card>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/question-choices.js" asp-append-version="true"></script>
}
