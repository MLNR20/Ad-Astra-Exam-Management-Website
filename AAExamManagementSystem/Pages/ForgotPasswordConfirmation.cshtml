@page
@model ForgotPasswordConfirmationModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check Your Email - Exam Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="login-page d-flex align-items-center justify-content-center min-vh-100 p-3">
        <div class="card login-card border-0 shadow-sm w-100">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="login-logo mx-auto mb-3">
                        <i class="bi bi-envelope-check" aria-hidden="true"></i>
                    </div>
                    <h1 class="h4 fw-bold mb-1">Check your email</h1>
                    <p class="text-muted mb-0">
                        If an account with that email exists, a password reset link has been generated.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ResetLink))
                {
                    <div class="alert alert-info small">
                        <p class="fw-semibold mb-1">
                            <i class="bi bi-info-circle" aria-hidden="true"></i> No email service is configured for this project.
                        </p>
                        <p class="mb-2">Use this link to reset the password:</p>
                        <a href="@Model.ResetLink" class="text-break">@Model.ResetLink</a>
                    </div>
                }

                <a asp-page="/Login" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Back to Login
                </a>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
