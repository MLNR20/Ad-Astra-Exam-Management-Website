@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ad Astra Exam Management System</title>
    <link rel="icon" type="image/png" href="~/images/adastra-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-light bg-white shadow-sm mb-0 site-navbar">
        <div class="container-fluid d-flex align-items-center justify-content-between px-5">
            <a asp-page="/Index" class="navbar-brand d-flex align-items-center gap-2 mb-0">
                <img src="~/images/adastra-mark.png" alt="" class="signup-navbar-mark" />
                <span class="fw-semibold">AD ASTRA</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a asp-page="/Signup" class="btn btn-outline-dark fw-semibold">Apply Now</a>
                <a asp-page="/Login" class="btn btn-dark fw-semibold">Login</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        <section class="hero-banner text-white p-5">
            <div class="container-fluid py-4">
                <span class="d-block fs-4 fw-normal text-white-50 mb-1">Welcome to</span>
                <h1 class="display-5 fw-bold mb-3">Ad Astra Recruitment Portal</h1>
                <p class="text-white-50 fs-4 mb-4">Where great staff meet their next big opportunity.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-page="/Signup" class="btn btn-light btn-lg fw-semibold">Apply as a Candidate</a>
                </div>
            </div>
        </section>

        @if (Model.Announcements.Count > 0)
        {
            <section class="hero-footer-bar position-relative d-flex align-items-center text-start text-white px-5" id="announcementCarousel" data-interval="6000">
                <div class="flex-grow-1">
                    @for (var i = 0; i < Model.Announcements.Count; i++)
                    {
                        var announcement = Model.Announcements[i];
                        <div class="announcement-slide d-flex flex-column @(i == 0 ? "" : "d-none")" data-index="@i">
                            <span class="hero-footer-title fw-bold">@announcement.Title</span>
                            <span class="hero-footer-subheader text-white-50">@announcement.Subheader</span>
                        </div>
                    }
                </div>
                @if (Model.Announcements.Count > 1)
                {
                    <button type="button" class="btn btn-outline-light btn-sm rounded-circle announcement-next-btn flex-shrink-0 d-flex align-items-center justify-content-center" aria-label="Next announcement">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </section>
        }
        else
        {
            <section class="hero-footer-bar" aria-hidden="true"></section>
        }

        <section class="container-fluid p-5 about-section">
            <div class="text-start mb-4">
                <span class="d-inline-block bg-dark text-white rounded-pill px-5 py-3 fw-bold fs-3 mb-4">About Ad Astra</span>
            </div>
            <div style="max-width: 900px;">
                <p class="text-muted fs-5 text-start">
                    Ad Astra is DLS-CSB&rsquo;s official student organization tasked to produce the College yearbook. As a yearbook organization, Ad Astra aims to tell authentic stories and capture timeless memories and experiences. Ad Astra also strives to strengthen the College&rsquo;s identity by producing content about Benildeans, for Benildeans.
                </p>
                <p class="text-muted fs-5 text-center mb-0">
                    Ad Astra currently has three major publications produced every academic year:
                </p>
            </div>
        </section>

        <section class="container-fluid p-5">
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <i class="bi bi-mortarboard display-5 mb-3" aria-hidden="true"></i>
                    <h5 class="fw-bold">For Applicants</h5>
                    <p class="text-muted">Submit your application and take your qualifying exam online, anytime.</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-clipboard-check display-5 mb-3" aria-hidden="true"></i>
                    <h5 class="fw-bold">For Staff</h5>
                    <p class="text-muted">Manage departments, courses, questions, and review exam attempts with ease.</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-bar-chart-line display-5 mb-3" aria-hidden="true"></i>
                    <h5 class="fw-bold">Insightful Analytics</h5>
                    <p class="text-muted">Track performance and outcomes with real-time dashboards.</p>
                </div>
            </div>
        </section>

        <section class="container-fluid p-5">
            <div class="text-center mb-5">
                <span class="d-inline-block bg-dark text-white rounded-pill px-5 py-3 fw-bold text-uppercase fs-3 mb-3">General Exam Reminders</span>
                <p class="text-muted fs-5 mb-0">Take note of the following reminders before proceeding with the exam.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border rounded-4">
                        <div class="card-body text-center p-4">
                            <span class="reminder-number mx-auto mb-3">1</span>
                            <p class="mb-0">Read all of the questions first before answering.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border rounded-4">
                        <div class="card-body text-center p-4">
                            <span class="reminder-number mx-auto mb-3">2</span>
                            <p class="mb-0">Keep your essay answers short and concise. It is better to write a short response that hits the point of the question than a long essay that talks about something else.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border rounded-4">
                        <div class="card-body text-center p-4">
                            <span class="reminder-number mx-auto mb-3">3</span>
                            <p class="mb-0">Once you exceed past the allotted time for taking your exam, your submission will automatically be marked as &ldquo;late&rdquo;, so make sure to submit your answers on time.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    @await Html.PartialAsync("_AdAstraFooter")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var carousel = document.getElementById('announcementCarousel');
            if (!carousel) return;

            var slides = carousel.querySelectorAll('.announcement-slide');
            if (slides.length < 2) return;

            var intervalMs = parseInt(carousel.dataset.interval, 10) || 6000;
            var currentIndex = 0;
            var timer;

            function showSlide(index) {
                slides[currentIndex].classList.add('d-none');
                currentIndex = (index + slides.length) % slides.length;
                slides[currentIndex].classList.remove('d-none');
            }

            function goToNext() {
                showSlide(currentIndex + 1);
            }

            function resetTimer() {
                clearInterval(timer);
                timer = setInterval(goToNext, intervalMs);
            }

            var nextBtn = carousel.querySelector('.announcement-next-btn');
            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    goToNext();
                    resetTimer();
                });
            }

            resetTimer();
        })();
    </script>
</body>
</html>
