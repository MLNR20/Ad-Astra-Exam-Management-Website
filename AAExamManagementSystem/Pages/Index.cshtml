@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ad Astra Exam Management System</title>
    <link rel="icon" type="image/png" href="~/images/adastra-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-light bg-white shadow-sm mb-0 site-navbar">
        <div class="container-fluid d-flex align-items-center justify-content-between px-5">
            <a asp-page="/Index" class="navbar-brand d-flex align-items-center gap-2 mb-0">
                <img src="~/images/adastra-mark.png" alt="" class="signup-navbar-mark" />
                <span class="fw-semibold">AD ASTRA</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a asp-page="/Signup" class="btn btn-outline-dark fw-semibold">Apply Now</a>
                <a asp-page="/Login" class="btn btn-dark fw-semibold">Login</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        <section class="hero-banner text-white p-5">
            <div class="container-fluid py-4">
                <span class="d-block fs-4 fw-normal text-white-50 mb-1" style="font-size: 2.4rem;">Welcome to</span>
                <h1 class="display-5 fw-bold mb-3" style="font-size: 2.8rem;">Ad Astra Recruitment Portal</h1>
                <p class="text-white-50 fs-4 mb-4" style="font-size: 2.4rem;">Where great staff meet their next big opportunity.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-page="/Signup" class="btn btn-light btn-lg fw-semibold" style="font-size: 1.2rem;">Apply as a Candidate</a>
                </div>
            </div>
        </section>

        @if (Model.Announcements.Count > 0)
        {
            <section class="hero-footer-bar position-relative d-flex align-items-center text-start text-white px-5" id="announcementCarousel" data-interval="6000">
                <div class="flex-grow-1">
                    @for (var i = 0; i < Model.Announcements.Count; i++)
                    {
                        var announcement = Model.Announcements[i];
                        <div class="announcement-slide d-flex flex-column @(i == 0 ? "" : "d-none")" data-index="@i">
                            <span class="hero-footer-title fw-bold">@announcement.Title</span>
                            <span class="hero-footer-subheader text-white-50">@announcement.Subheader</span>
                        </div>
                    }
                </div>
                @if (Model.Announcements.Count > 1)
                {
                    <button type="button" class="btn btn-outline-light btn-sm rounded-circle announcement-next-btn flex-shrink-0 d-flex align-items-center justify-content-center" aria-label="Next announcement">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </section>
        }
        else
        {
            <section class="hero-footer-bar d-flex align-items-center text-start text-white px-5">
                <div class="flex-grow-1 d-flex flex-column announcement-slide">
                    <span class="hero-footer-title fw-bold">We're all good for now!</span>
                    <span class="hero-footer-subheader text-white-50">Kindly view our Ad Astra's social media page for recruitment announcements and updates.</span>
                </div>
            </section>
        }

        <section class="container-fluid p-5 about-section">
            <div class="text-center mb-4">
                <span class="d-inline-block bg-dark text-white rounded-pill px-5 py-4 fw-bold fs-3 mb-4">About Ad Astra</span>
            </div>
            <div class="mx-auto" style="max-width: 1000px;">
                <p class="text-muted fs-5 text-center">
                    Ad Astra is De La Salle-College of Saint Benilde's (DLS-CSB) official student organization tasked to produce the College yearbook, capturing in text and images the graduating batches&rsquo; dreams and aspirations, momentous events in school, various curricular and extracurricular activities, including messages from their administrators and mentors.
                </p>
                <p class="text-muted fs-5 text-center">
                    Ad Astra currently has three major publications produced every academic year:
                </p>
                <ol class="text-muted fs-5 text-center d-inline-block mx-auto" style="list-style-position: inside; padding-left: 6rem;">
                    <li>AD ASTRA, the College&rsquo;s official yearbook for graduating students;</li>
                    <li>EMBARK, the College&rsquo;s official socio-cultural magazine for Frosh students; and</li>
                    <li>BEYOND, the organization&rsquo;s online content on various social media platforms.</li>
                </ol>
                <p class="text-muted fs-5 text-center">
                    The organization caters to the special interests of students in publication-related activities, such as writing and copyediting, layout and graphic design, photography and videography, graphic illustration, marketing and publicity, web development, and customer support.
                </p>
                <p class="text-muted fs-5 text-center mb-0">
                    Ad Astra is an organization under the Student Publications Unit (SPU) of the Center for Student Life (CSL). It has a sister organization in SPU named the Benildean Press Corps (BPC), which is the student-journalists' organization of DLS-CSB.
                </p>
            </div>
        </section>

        <section class="container-fluid p-5 after-exam-header text-center">
            <h2 class="display-4 fw-extrabold text-white mb-2">Ad Astra Level 1 Exams</h2>
            <p class="fw-bold text-white fs-4 mb-0">Ready to reach for the stars?</p>
        </section>

        <section class="container-fluid p-5">
            <div class="text-center mb-5">
                <span class="d-inline-block bg-dark text-white rounded-pill px-5 py-3 fw-bold text-uppercase fs-3 mb-3">General Exam Reminders</span>
                <p class="text-muted fs-5 mb-0">Take note of the following reminders before proceeding with the exam.</p>
            </div>
            <div class="mx-auto" style="max-width: 900px;">
                <div class="d-flex align-items-start gap-4 mb-5">
                    <span class="reminder-number flex-shrink-0">1</span>
                    <p class="fs-5 mb-0">Read all of the questions first before answering.</p>
                </div>
                <div class="d-flex align-items-start gap-4 mb-5">
                    <span class="reminder-number flex-shrink-0">2</span>
                    <p class="fs-5 mb-0">Keep your essay answers short and concise. It is better to write a short response that hits the point of the question than a long essay that talks about something else.</p>
                </div>
                <div class="d-flex align-items-start gap-4 mb-5">
                    <span class="reminder-number flex-shrink-0">3</span>
                    <p class="fs-5 mb-0">Once you exceed past the allotted time for taking your exam, your submission will automatically be marked as &ldquo;late&rdquo;, so make sure to submit your answers on time.</p>
                </div>
                <div class="d-flex align-items-start gap-4 mb-5">
                    <span class="reminder-number flex-shrink-0">4</span>
                    <div>
                        <p class="fs-5 mb-3">For questions that is hard to format, you can put a Google Docs link that directs us to your answer.</p>
                        <p class="fs-5 mb-0">Open a separate document where you can write your answers first. When you&rsquo;re satisfied with your answers, paste them into the text box. Changes made after the exam time will not be accepted.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-4">
                    <span class="reminder-number flex-shrink-0">5</span>
                    <p class="fs-5 mb-0">Ten (10) minutes before the exam, our managing team will send an email reminder about the exam date.</p>
                </div>
            </div>
        </section>

        <section class="container-fluid p-5 after-exam-header text-center">
            <span class="d-inline-block bg-white text-dark rounded-pill px-5 py-3 fw-bold text-uppercase fs-3 mb-3">After the Exam</span>
            <p class="text-white fs-5 mb-0">Once you have submitted your exam, take note of the following.</p>
        </section>
        <section class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-md-6 bg-white">
                    <div class="text-center p-5 after-exam-step">
                        <span class="reminder-number mx-auto mb-3">1</span>
                        <h2 class="fw-bold mb-3">Interview</h2>
                        <p class="text-muted mb-0" style="font-size: 1.2rem;">If you qualify for an online interview, Ad Astra will contact you to set a schedule.</p>
                        <p class="text-muted mb-0 mt-3" style="font-size: 1.2rem;">Make sure to reply to confirm your slot.</p>
                    </div>
                </div>
                <div class="col-md-6 about-section">
                    <div class="text-center p-5 after-exam-step">
                        <span class="reminder-number mx-auto mb-3">2</span>
                        <h2 class="fw-bold mb-3">Results</h2>
                        <p class="text-muted mb-0" style="font-size: 1.2rem;">Applicants must pass all previous steps to qualify for a membership slot.</p>
                        <p class="text-muted mb-0 mt-3" style="font-size: 1.2rem;">We will announce accepted applicants via social media accounts and email.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="container-fluid p-5 after-exam-header text-center">
            <h2 class="fw-extrabold text-white mb-0">#JoinAdAstra</h2>
        </section>
        <section class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-md-6 about-section">
                    <div class="text-center p-5 after-exam-step">
                        <h2 class="fw-bold mb-3">Level 1 Exam</h2>
                        <p class="text-muted mb-0" style="font-size: 1.2rem;">Log in to your account using the credentials provided by Ad Astra!</p>
                        <p class="text-muted mb-0 mt-3" style="font-size: 1.2rem;">Be sure to remember your student ID number and password.</p>
                    </div>
                </div>
                <div class="col-md-6 bg-white">
                    <div class="text-center p-5 after-exam-step">
                        <h2 class="fw-bold mb-3">Ready to reach for the stars?</h2>
                        <p class="text-muted mb-4" style="font-size: 1.2rem;">Click to login to your account!</p>
                        <a asp-page="/Login" class="btn btn-dark rounded-pill fw-bold text-uppercase px-5 py-2">Begin</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    @await Html.PartialAsync("_AdAstraFooter")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var carousel = document.getElementById('announcementCarousel');
            if (!carousel) return;

            var slides = carousel.querySelectorAll('.announcement-slide');
            if (slides.length < 2) return;

            var intervalMs = parseInt(carousel.dataset.interval, 10) || 6000;
            var currentIndex = 0;
            var timer;

            function showSlide(index) {
                slides[currentIndex].classList.add('d-none');
                currentIndex = (index + slides.length) % slides.length;
                slides[currentIndex].classList.remove('d-none');
            }

            function goToNext() {
                showSlide(currentIndex + 1);
            }

            function resetTimer() {
                clearInterval(timer);
                timer = setInterval(goToNext, intervalMs);
            }

            var nextBtn = carousel.querySelector('.announcement-next-btn');
            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    goToNext();
                    resetTimer();
                });
            }

            resetTimer();
        })();
    </script>
</body>
</html>
