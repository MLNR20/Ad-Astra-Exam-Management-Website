@page
@model AAExamManagementSystem.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "departmentsTable",
    basePath = "/Departments",
    emptyMessage = "No departments found.",
    items = Model.Departments.Select(d => new EntityTableRow(d.Id.ToString(), d.Name, d.IsActive, d.CreatedAt, DateUpdated: d.DateUpdated)),
    title = "Departments",
    titleClass = "fw-semibold",
    addButtonText = "New Department",
    addButtonModalTarget = "#createDepartmentModal",
    showStatusColumn = true,
    showDateCreatedColumn = true,
    showDateUpdatedColumn = true,
    confirmDeleteWithSweetAlert = true,
    confirmCreateWithSweetAlert = true,
    entityName = "Department",
    useSoftDelete = true
})

<div class="modal fade" id="createDepartmentModal" tabindex="-1" aria-labelledby="createDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" class="js-sweetalert-create-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="createDepartmentModalLabel">New Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewDepartment.Name" class="form-label"></label>
                        <input asp-for="NewDepartment.Name" class="form-control" />
                        <span asp-validation-for="NewDepartment.Name" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="NewDepartment.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="NewDepartment.IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/sweetalert-toast.js" asp-append-version="true"></script>
    <partial name="_SuccessToast" />
    <script>
        $(function () {
            if ($('#departmentsTable').length) {
                initEntityTable('departmentsTable');
            }
            @if (Model.ShowCreateModal)
            {
                <text>new bootstrap.Modal(document.getElementById('createDepartmentModal')).show();</text>
            }
        });
    </script>
}
