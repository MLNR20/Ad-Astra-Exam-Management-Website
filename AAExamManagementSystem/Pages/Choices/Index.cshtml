@page
@model AAExamManagementSystem.Pages.Choices.IndexModel
@{
    ViewData["Title"] = "Choices";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "choicesTable",
    basePath = "/Choices",
    emptyMessage = "No choices found.",
    items = Model.Choices.Select(c => new EntityTableRow(c.Id.ToString(), c.ChoiceText.Length > 80 ? c.ChoiceText.Substring(0, 80) + "…" : c.ChoiceText, c.IsActive, Section: c.SectionName)),
    title = "Choices",
    addButtonText = "New Choice",
    addButtonModalTarget = "#createChoiceModal",
    showStatusColumn = true,
    showSectionColumn = true,
    confirmDeleteWithSweetAlert = true,
    confirmCreateWithSweetAlert = true,
    entityName = "Choice"
})

<div class="modal fade" id="createChoiceModal" tabindex="-1" aria-labelledby="createChoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" class="js-sweetalert-create-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="createChoiceModalLabel">New Choice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewChoice.ChoiceText" class="form-label"></label>
                        <textarea asp-for="NewChoice.ChoiceText" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="NewChoice.ChoiceText" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="NewChoice.IsCorrect" class="form-check-input" role="switch" />
                        <label asp-for="NewChoice.IsCorrect" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="NewChoice.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="NewChoice.IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            if ($('#choicesTable').length) {
                initEntityTable('choicesTable');
            }
            @if (Model.ShowCreateModal)
            {
                <text>new bootstrap.Modal(document.getElementById('createChoiceModal')).show();</text>
            }

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                </text>
            }

            document.querySelectorAll('.js-sweetalert-delete-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Delete choice?',
                        text: 'Are you sure you want to delete this choice? This action cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Delete',
                        confirmButtonColor: '#dc3545',
                        cancelButtonText: 'Cancel'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}
